# Workshop deploys and Bedrock model access are in us-east-1.
AWS_REGION=us-east-1

# Module 1 defaults to the Strands Bedrock model when this is empty.
# Claude Sonnet streaming needs the Anthropic use case form on this account.
# Amazon Nova Pro is enabled and supports the agent loop.
CAREBRIDGE_MODEL_ID=us.amazon.nova-pro-v1:0

# Check-in replies are short, so they use a faster model than discharge extraction.
CAREBRIDGE_CHECKIN_MODEL_ID=us.amazon.nova-lite-v1:0

# Local files for plans, documents, and dialog state.
CAREBRIDGE_DATA_DIR=.carebridge

# Module 4. Set a bucket to use S3SessionManager instead of FileSessionManager.
CAREBRIDGE_SESSION_BUCKET=

# Original discharge files and multi-page PDFs (Amazon Textract via S3).
CAREBRIDGE_DOCUMENT_BUCKET=

# Module 3 LLM tone guardrail. Nova Pro loops on that handler's structured-output tool.
# Deterministic steering still enforces doses and escalation. Set to 1 for a Claude model.
CAREBRIDGE_LLM_STEERING=0

# Module 2. Per-tool cap inside a single agent invocation.
CAREBRIDGE_MAX_TOOL_CALLS=3

# Google Calendar phone reminders. Create a Web OAuth client in Google Cloud,
# enable the Google Calendar API, and set the authorized redirect URI to the value below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/v1/calendar/callback
CAREBRIDGE_APP_URL=http://127.0.0.1:8080/plan
CAREBRIDGE_TIMEZONE=Asia/Beirut

# Doctor notice when safety rules return emergency or review.
# Set the doctor address alone to save the draft under .carebridge/doctor_mail/.
# Set the SMTP host as well to send it. Use TLS=0 for a plain local relay on port 1025.
CAREBRIDGE_DOCTOR_EMAIL=
CAREBRIDGE_SMTP_HOST=
CAREBRIDGE_SMTP_PORT=587
CAREBRIDGE_SMTP_USER=
CAREBRIDGE_SMTP_PASSWORD=
CAREBRIDGE_SMTP_FROM=
CAREBRIDGE_SMTP_TLS=1
